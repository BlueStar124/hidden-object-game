  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "generate": "npm --prefix .. run generate",
    "generate:icons": "npm --prefix .. run generate:icons",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint --max-warnings 0",
    "test": "jest",
    "check:architecture": "node ../tools/check-architecture.mjs",
    "test:screens": "node ../tools/test-screens.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run check:architecture && node ../tools/check-supabase-catalog.mjs",
    "postinstall": "setup-skia-web public"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/test"
    ]
  },
  "private": true
